```gitignore
# Python cache
__pycache__/
*.py[cod]
*$py.class

# Python virtual environments
.venv/
.venv-1/
venv/
env/
ENV/

# Dataset - keep local, do not upload
data/
*.csv
*.xlsx

# Generated patient reports - keep private
reports/reports.json
reports/*.csv
reports/*.pdf
reports/*.xlsx

# Secrets and environment files
.env
.env.*
!.env.example

# Generated test and analysis files
.pytest_cache/
.mypy_cache/
.coverage

# Operating system files
.DS_Store
Thumbs.db

# Editor settings
.vscode/
```
